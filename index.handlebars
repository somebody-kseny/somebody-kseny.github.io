<html lang='ru'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>{{name}}, {{profession}}</title>
        <link rel='icon' type='image/x-icon' href='/static/favicon.ico' />
        <link rel='preconnect' href='https://fonts.googleapis.com' />
        <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
        <link
            href='https://fonts.googleapis.com/css2?family=Lora:ital@1&family=Montserrat:wght@400..700&display=swap'
            rel='stylesheet'
        />
        <link rel='stylesheet' href='./drop_default.css' />
        <link rel='stylesheet' href='./styles.css' />
    </head>
    <body>
        <div class='wrapper'>
            <header class='block'>
                <h1>{{name}}</h1>
                <h3>{{profession}}</h3>
            </header>
            <aside class='block'>
                <div id='aside-card'>
                    <img src='static/photo.png' alt='Фотография' id='photo' />
                    <section>
                        {{#each contacts}}
                            <div class='contacts-line'>
                                {{inlineSvg this.icon}}
                                {{#isLink this}}
                                    <a href={{this.href}}>{{this.text}}</a>
                                {{else}}
                                    <p>{{this.text}}</p>
                                {{/isLink}}
                            </div>
                        {{/each}}
                    </section>
                </div>
            </aside>
            <main class='block'>
                <section>
                    <h2>{{summary.header}}</h2>
                    <p>{{summary.subheader}}</p>

                    {{#each summary.list}}
                        <p class='underlined'>{{this.header}}:</p>
                        <ul>
                            {{#each this.list}}
                                <li>{{this}}</li>
                            {{/each}}
                        </ul>
                    {{/each}}
                </section>
                <section>
                    <h2>{{exp.header}}</h2>
                    {{#each exp.list}}
                        <h3 class='underlined'>{{this.header}}</h3>
                        <p class='underlined'>{{this.time}}</p>
                        <p>{{this.subheader}}</p>
                        <p>{{this.summary}}</p>
                        <ul>
                            {{#each this.list}}
                                <li>{{this}}</li>
                            {{/each}}
                        </ul>
                    {{/each}}
                </section>
                <section>
                    <h2>{{edu.header}}</h2>
                    {{#each edu.list}}
                        <h3 class='underlined'>{{this.header}}</h3>
                        <ul>
                            {{#each this.list}}
                                <li>
                                    {{this.header}}
                                    &nbsp;—&nbsp;
                                    {{this.time}}
                                </li>
                            {{/each}}
                        </ul>
                    {{/each}}
                </section>
            </main>
        </div>

    </body>
</html>